@echo off
setlocal
chcp 65001 >nul
set "FONT_SCRIPT_DIR=%~dp0"
title Install Project Fonts

echo.
echo This installs font files from the Fonts folder next to this BAT file.
echo.
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
set "RESULT=%ERRORLEVEL%"
echo.
if not "%RESULT%"=="0" (
    echo May ilang font na hindi na-process. Basahin ang error sa itaas.
) else (
    echo Tapos na ang installer command.
)
echo.
pause
exit /b %RESULT%
